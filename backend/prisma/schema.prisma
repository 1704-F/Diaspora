// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ================================
// MULTI-TENANT TABLES
// ================================

model Tenant {
  id                   String   @id @default(uuid())
  name                 String
  slug                 String   @unique
  type                 TenantType @default(SIMPLE)
  logoUrl              String?  @map("logo_url")
  primaryCurrency      String   @default("EUR") @map("primary_currency") @db.VarChar(3)
  primaryLanguage      String   @default("fr") @map("primary_language") @db.VarChar(2)
  status               TenantStatus @default(ACTIVE)
  subscriptionPlan     String?  @map("subscription_plan")
  subscriptionStatus   String?  @map("subscription_status")
  settings             Json     @default("{}")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  // Relations
  sections             Section[]
  members              Member[]
  roles                Role[]
  contributionTypes    ContributionType[]
  contributions        Contribution[]
  payments             Payment[]
  transactions         Transaction[]
  budgets              Budget[]
  projects             Project[]
  events               Event[]
  memberAssistance     MemberAssistance[]
  auditLogs            AuditLog[]

  @@map("tenants")
}

model Section {
  id                String   @id @default(uuid())
  tenantId          String   @map("tenant_id")
  parentSectionId   String?  @map("parent_section_id")
  name              String
  country           String   @db.VarChar(2)
  currency          String   @db.VarChar(3)
  language          String   @db.VarChar(2)
  settings          Json     @default("{}")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Relations
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  parentSection     Section? @relation("SectionHierarchy", fields: [parentSectionId], references: [id])
  childSections     Section[] @relation("SectionHierarchy")
  members           Member[]
  roles             Role[]
  transactions      Transaction[]
  budgets           Budget[]
  projects          Project[]
  events            Event[]

  @@index([tenantId])
  @@index([parentSectionId])
  @@map("sections")
}

// ================================
// USER & MEMBER TABLES
// ================================

model User {
  id                  String   @id @default(uuid())
  email               String   @unique
  passwordHash        String   @map("password_hash")
  firstName           String   @map("first_name") @db.VarChar(100)
  lastName            String   @map("last_name") @db.VarChar(100)
  phone               String?  @db.VarChar(20)
  avatarUrl           String?  @map("avatar_url")
  language            String   @default("fr") @db.VarChar(2)
  timezone            String   @default("Europe/Paris") @db.VarChar(50)
  twoFactorEnabled    Boolean  @default(false) @map("two_factor_enabled")
  twoFactorSecret     String?  @map("two_factor_secret")
  emailVerified       Boolean  @default(false) @map("email_verified")
  emailVerificationToken String? @map("email_verification_token")
  passwordResetToken  String?  @map("password_reset_token")
  passwordResetExpires DateTime? @map("password_reset_expires")
  lastLoginAt         DateTime? @map("last_login_at")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  // Relations
  members             Member[]
  createdTransactions Transaction[] @relation("TransactionCreator")
  validatedTransactions Transaction[] @relation("TransactionValidator")
  createdProjects     Project[] @relation("ProjectCreator")
  postedProjectUpdates ProjectUpdate[]
  createdEvents       Event[]
  writtenEventMinutes EventMinutes[] @relation("MinutesWriter")
  approvedEventMinutes EventMinutes[] @relation("MinutesApprover")
  decidedAssistance   MemberAssistance[]
  assignedRoles       MemberRole[]
  auditLogs           AuditLog[]

  @@index([email])
  @@map("users")
}

model Member {
  id              String       @id @default(uuid())
  tenantId        String       @map("tenant_id")
  sectionId       String?      @map("section_id")
  userId          String       @map("user_id")
  memberNumber    String?      @unique @map("member_number")
  statusType      MemberStatusType @map("status_type")
  dateOfBirth     DateTime?    @map("date_of_birth") @db.Date
  address         String?
  city            String?      @db.VarChar(100)
  country         String?      @db.VarChar(2)
  cityOfOrigin    String?      @map("city_of_origin") @db.VarChar(100)
  membershipDate  DateTime     @map("membership_date") @db.Date
  status          MemberStatus @default(ACTIVE)
  metadata        Json         @default("{}")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  // Relations
  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  section         Section?     @relation(fields: [sectionId], references: [id])
  user            User         @relation(fields: [userId], references: [id])
  roles           MemberRole[]
  contributions   Contribution[]
  payments        Payment[]
  responsibleProjects Project[]
  eventParticipations EventParticipant[]
  assistance      MemberAssistance[]

  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([sectionId])
  @@index([userId])
  @@index([status])
  @@map("members")
}

model Role {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  sectionId   String?  @map("section_id")
  name        String   @db.VarChar(100)
  slug        String   @db.VarChar(100)
  description String?
  permissions Json     @default("[]")
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Relations
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  section     Section? @relation(fields: [sectionId], references: [id])
  memberRoles MemberRole[]

  @@unique([tenantId, slug])
  @@map("roles")
}

model MemberRole {
  id          String    @id @default(uuid())
  memberId    String    @map("member_id")
  roleId      String    @map("role_id")
  assignedAt  DateTime  @default(now()) @map("assigned_at")
  assignedBy  String    @map("assigned_by")
  validFrom   DateTime? @map("valid_from") @db.Date
  validUntil  DateTime? @map("valid_until") @db.Date

  // Relations
  member      Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  role        Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedByUser User   @relation(fields: [assignedBy], references: [id])

  @@unique([memberId, roleId])
  @@map("member_roles")
}

// ================================
// FINANCIAL TABLES
// ================================

model ContributionType {
  id                String   @id @default(uuid())
  tenantId          String   @map("tenant_id")
  name              String   @db.VarChar(100)
  description       String?
  frequency         ContributionFrequency
  baseAmount        Decimal  @map("base_amount") @db.Decimal(15, 2)
  currency          String   @db.VarChar(3)
  statusMultipliers Json     @default("{}") @map("status_multipliers")
  isMandatory       Boolean  @default(true) @map("is_mandatory")
  createdAt         DateTime @default(now()) @map("created_at")

  // Relations
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contributions     Contribution[]

  @@map("contribution_types")
}

model Contribution {
  id                   String              @id @default(uuid())
  tenantId             String              @map("tenant_id")
  memberId             String              @map("member_id")
  contributionTypeId   String              @map("contribution_type_id")
  amount               Decimal             @db.Decimal(15, 2)
  currency             String              @db.VarChar(3)
  dueDate              DateTime            @map("due_date") @db.Date
  status               ContributionStatus  @default(PENDING)
  createdAt            DateTime            @default(now()) @map("created_at")
  updatedAt            DateTime            @updatedAt @map("updated_at")

  // Relations
  tenant               Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member               Member              @relation(fields: [memberId], references: [id], onDelete: Cascade)
  contributionType     ContributionType    @relation(fields: [contributionTypeId], references: [id])
  payments             Payment[]

  @@index([tenantId])
  @@index([memberId])
  @@index([dueDate])
  @@map("contributions")
}

model Payment {
  id                    String         @id @default(uuid())
  tenantId              String         @map("tenant_id")
  memberId              String         @map("member_id")
  contributionId        String?        @map("contribution_id")
  amount                Decimal        @db.Decimal(15, 2)
  currency              String         @db.VarChar(3)
  paymentMethod         PaymentMethod  @map("payment_method")
  paymentDate           DateTime       @map("payment_date") @db.Date
  referenceNumber       String?        @map("reference_number") @db.VarChar(100)
  receiptUrl            String?        @map("receipt_url")
  notes                 String?
  recordedBy            String?        @map("recorded_by")
  isManual              Boolean        @default(false) @map("is_manual")
  externalTransactionId String?        @map("external_transaction_id")
  status                PaymentStatus  @default(COMPLETED)
  createdAt             DateTime       @default(now()) @map("created_at")

  // Relations
  tenant                Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member                Member         @relation(fields: [memberId], references: [id], onDelete: Cascade)
  contribution          Contribution?  @relation(fields: [contributionId], references: [id])
  transactions          Transaction[]

  @@index([tenantId])
  @@index([memberId])
  @@index([paymentDate])
  @@map("payments")
}

model Transaction {
  id              String           @id @default(uuid())
  tenantId        String           @map("tenant_id")
  sectionId       String?          @map("section_id")
  type            TransactionType
  category        String           @db.VarChar(100)
  amount          Decimal          @db.Decimal(15, 2)
  currency        String           @db.VarChar(3)
  description     String
  transactionDate DateTime         @map("transaction_date") @db.Date
  paymentId       String?          @map("payment_id")
  projectId       String?          @map("project_id")
  receiptUrl      String?          @map("receipt_url")
  validatedBy     String?          @map("validated_by")
  validatedAt     DateTime?        @map("validated_at")
  createdBy       String           @map("created_by")
  metadata        Json             @default("{}")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  // Relations
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  section         Section?         @relation(fields: [sectionId], references: [id])
  payment         Payment?         @relation(fields: [paymentId], references: [id])
  project         Project?         @relation(fields: [projectId], references: [id])
  validator       User?            @relation("TransactionValidator", fields: [validatedBy], references: [id])
  creator         User             @relation("TransactionCreator", fields: [createdBy], references: [id])

  @@index([tenantId])
  @@index([transactionDate])
  @@index([type])
  @@map("transactions")
}

model Budget {
  id            String       @id @default(uuid())
  tenantId      String       @map("tenant_id")
  sectionId     String?      @map("section_id")
  name          String
  fiscalYear    Int          @map("fiscal_year")
  totalAmount   Decimal      @map("total_amount") @db.Decimal(15, 2)
  currency      String       @db.VarChar(3)
  categories    Json
  status        BudgetStatus @default(DRAFT)
  approvedBy    String?      @map("approved_by")
  approvedAt    DateTime?    @map("approved_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  // Relations
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  section       Section?     @relation(fields: [sectionId], references: [id])

  @@map("budgets")
}

// ================================
// PROJECT TABLES
// ================================

model Project {
  id                  String        @id @default(uuid())
  tenantId            String        @map("tenant_id")
  sectionId           String?       @map("section_id")
  title               String
  description         String
  objectives          String?
  budgetAmount        Decimal       @map("budget_amount") @db.Decimal(15, 2)
  currency            String        @db.VarChar(3)
  budgetSource        String        @map("budget_source") @db.VarChar(50)
  status              ProjectStatus @default(PLANNED)
  progressPercentage  Int           @default(0) @map("progress_percentage")
  startDate           DateTime?     @map("start_date") @db.Date
  endDate             DateTime?     @map("end_date") @db.Date
  responsibleMemberId String?       @map("responsible_member_id")
  successIndicators   String?       @map("success_indicators")
  metadata            Json          @default("{}")
  createdBy           String        @map("created_by")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  // Relations
  tenant              Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  section             Section?      @relation(fields: [sectionId], references: [id])
  responsibleMember   Member?       @relation(fields: [responsibleMemberId], references: [id])
  creator             User          @relation("ProjectCreator", fields: [createdBy], references: [id])
  updates             ProjectUpdate[]
  transactions        Transaction[]

  @@index([tenantId])
  @@index([status])
  @@map("projects")
}

model ProjectUpdate {
  id                 String   @id @default(uuid())
  projectId          String   @map("project_id")
  title              String
  content            String
  progressPercentage Int?     @map("progress_percentage")
  photos             Json     @default("[]")
  documents          Json     @default("[]")
  postedBy           String   @map("posted_by")
  createdAt          DateTime @default(now()) @map("created_at")

  // Relations
  project            Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  poster             User     @relation(fields: [postedBy], references: [id])

  @@map("project_updates")
}

// ================================
// EVENT TABLES
// ================================

model Event {
  id                    String      @id @default(uuid())
  tenantId              String      @map("tenant_id")
  sectionId             String?     @map("section_id")
  title                 String
  description           String?
  type                  EventType
  startDate             DateTime    @map("start_date")
  endDate               DateTime?   @map("end_date")
  location              String?
  isVirtual             Boolean     @default(false) @map("is_virtual")
  virtualLink           String?     @map("virtual_link")
  agenda                String?
  preparatoryDocuments  Json        @default("[]") @map("preparatory_documents")
  status                EventStatus @default(SCHEDULED)
  createdBy             String      @map("created_by")
  createdAt             DateTime    @default(now()) @map("created_at")
  updatedAt             DateTime    @updatedAt @map("updated_at")

  // Relations
  tenant                Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  section               Section?    @relation(fields: [sectionId], references: [id])
  creator               User        @relation(fields: [createdBy], references: [id])
  participants          EventParticipant[]
  minutes               EventMinutes[]

  @@index([tenantId])
  @@index([startDate])
  @@map("events")
}

model EventParticipant {
  id           String                @id @default(uuid())
  eventId      String                @map("event_id")
  memberId     String                @map("member_id")
  status       ParticipationStatus   @default(INVITED)
  responseDate DateTime?             @map("response_date")
  attended     Boolean?
  createdAt    DateTime              @default(now()) @map("created_at")

  // Relations
  event        Event                 @relation(fields: [eventId], references: [id], onDelete: Cascade)
  member       Member                @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([eventId, memberId])
  @@map("event_participants")
}

model EventMinutes {
  id          String    @id @default(uuid())
  eventId     String    @map("event_id")
  content     String
  decisions   Json      @default("[]")
  nextActions Json      @default("[]") @map("next_actions")
  documentUrl String?   @map("document_url")
  writtenBy   String    @map("written_by")
  approvedBy  String?   @map("approved_by")
  approvedAt  DateTime? @map("approved_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  // Relations
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  writer      User      @relation("MinutesWriter", fields: [writtenBy], references: [id])
  approver    User?     @relation("MinutesApprover", fields: [approvedBy], references: [id])

  @@map("event_minutes")
}

// ================================
// MEMBER ASSISTANCE TABLE
// ================================

model MemberAssistance {
  id                String             @id @default(uuid())
  tenantId          String             @map("tenant_id")
  memberId          String             @map("member_id")
  type              AssistanceType
  amount            Decimal            @db.Decimal(15, 2)
  currency          String             @db.VarChar(3)
  reason            String
  status            AssistanceStatus   @default(PENDING)
  requestDate       DateTime           @map("request_date") @db.Date
  decisionDate      DateTime?          @map("decision_date") @db.Date
  decisionNotes     String?            @map("decision_notes")
  decidedBy         String?            @map("decided_by")
  disbursementDate  DateTime?          @map("disbursement_date") @db.Date
  repaymentRequired Boolean            @default(false) @map("repayment_required")
  repaymentTerms    Json?              @map("repayment_terms")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  // Relations
  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  member            Member             @relation(fields: [memberId], references: [id], onDelete: Cascade)
  decider           User?              @relation(fields: [decidedBy], references: [id])

  @@map("member_assistance")
}

// ================================
// AUDIT LOG TABLE
// ================================

model AuditLog {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  userId      String?  @map("user_id")
  action      String   @db.VarChar(100)
  entityType  String   @map("entity_type") @db.VarChar(100)
  entityId    String?  @map("entity_id")
  changes     Json?
  ipAddress   String?  @map("ip_address") @db.Inet
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user        User?    @relation(fields: [userId], references: [id])

  @@index([tenantId])
  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ================================
// ENUMS
// ================================

enum TenantType {
  SIMPLE
  MULTI_SECTION
}

enum TenantStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum MemberStatusType {
  FOUNDER
  HONORARY
  ACTIVE
  BENEFACTOR
  ASSOCIATE
}

enum MemberStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ContributionFrequency {
  MONTHLY
  ANNUAL
  ONE_TIME
}

enum ContributionStatus {
  PENDING
  PAID
  OVERDUE
  WAIVED
}

enum PaymentMethod {
  CARD
  BANK_TRANSFER
  MOBILE_MONEY
  CASH
  OTHER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum BudgetStatus {
  DRAFT
  APPROVED
  ACTIVE
}

enum ProjectStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum EventType {
  AG
  MEETING
  SOCIAL
  ELECTION
  OTHER
}

enum EventStatus {
  SCHEDULED
  ONGOING
  COMPLETED
  CANCELLED
}

enum ParticipationStatus {
  INVITED
  CONFIRMED
  DECLINED
  ATTENDED
}

enum AssistanceType {
  EMERGENCY
  FUNERAL
  MEDICAL
  EDUCATION
  LOAN
}

enum AssistanceStatus {
  PENDING
  APPROVED
  REJECTED
  DISBURSED
}

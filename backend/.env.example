# Application
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/diaspora_dev

# Redis
REDIS_URL=redis://localhost:6379

# JWT (IMPORTANT: Generate strong secrets in production)
# Generate with: openssl rand -base64 32
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_EXPIRATION=15m
JWT_REFRESH_SECRET=your_refresh_secret_here_change_in_production
JWT_REFRESH_EXPIRATION=7d

# Email Configuration
# Provider: 'sendgrid' or 'smtp'
EMAIL_PROVIDER=smtp
EMAIL_FROM=noreply@diaspora-platform.com
EMAIL_FROM_NAME=Diaspora Platform

# SendGrid Configuration (if using SendGrid)
SENDGRID_API_KEY=your_sendgrid_api_key_here

# SMTP Configuration (if using SMTP)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Currency API
CURRENCY_API_KEY=your_currency_api_key
CURRENCY_API_URL=https://api.exchangerate-api.com/v4/latest

# File Upload
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/jpg,application/pdf

# AWS S3 (or DigitalOcean Spaces)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=eu-west-3
AWS_S3_BUCKET=diaspora-platform-dev

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Monitoring
# Sentry DSN for error tracking (optional)
SENTRY_DSN=your_sentry_dsn_here
SENTRY_LOG_ALL_ERRORS=false
